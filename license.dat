import sys
import os
from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QGridLayout, 
    QPushButton, QLineEdit, QLabel, QSizePolicy
)
from PyQt5.QtCore import Qt
from PyQt5.QtGui import QFont, QIcon, QPalette, QColor

class AICalculatorPro(QMainWindow):
    def __init__(self):
        super().__init__()
        self.initUI()
        
    def initUI(self):
        # نافذة التطبيق الرئيسية
        self.setWindowTitle("AI Calculator Pro")
        self.setFixedSize(360, 520)
        
        # تعيين أيقونة التطبيق إذا توفرت
        if os.path.exists("icon.ico"):
            self.setWindowIcon(QIcon("icon.ico"))
            
        # التصميم العام (Dark / Modern Theme)
        self.setStyleSheet("""
            QMainWindow {
                background-color: #1e1e2f;
            }
            QLineEdit {
                background-color: #27293d;
                color: #ffffff;
                font-size: 28px;
                border: none;
                border-radius: 10px;
                padding: 15px;
                selection-background-color: #3e3f5b;
            }
            QPushButton {
                background-color: #3a3f58;
                color: #ffffff;
                font-size: 18px;
                font-weight: bold;
                border: none;
                border-radius: 10px;
                min-height: 55px;
            }
            QPushButton:hover {
                background-color: #4e567a;
            }
            QPushButton:pressed {
                background-color: #2e3248;
            }
            QPushButton#opButton {
                background-color: #ff9f43;
                color: #ffffff;
            }
            QPushButton#opButton:hover {
                background-color: #ffb15c;
            }
            QPushButton#equalsButton {
                background-color: #2ed573;
                color: #ffffff;
            }
            QPushButton#equalsButton:hover {
                background-color: #4cd137;
            }
            QPushButton#clearButton {
                background-color: #ff4757;
                color: #ffffff;
            }
            QPushButton#clearButton:hover {
                background-color: #ff6b81;
            }
        """)

        # العنصر الرئيسي
        central_widget = QWidget(self)
        self.setCentralWidget(central_widget)
        layout = QVBoxLayout(central_widget)
        layout.setContentsMargins(15, 15, 15, 15)
        layout.setSpacing(10)

        # شاشة العرض (Display)
        self.display = QLineEdit()
        self.display.setAlignment(Qt.AlignRight)
        self.display.setReadOnly(True)
        self.display.setText("0")
        layout.addWidget(self.display)

        # تخطيط أزرار الآلة الحاسبة
        grid_layout = QGridLayout()
        grid_layout.setSpacing(10)
        
        buttons = [
            ('C', 0, 0, 'clearButton'), ('(', 0, 1, 'opButton'), (')', 0, 2, 'opButton'), ('/', 0, 3, 'opButton'),
            ('7', 1, 0, ''), ('8', 1, 1, ''), ('9', 1, 2, ''), ('*', 1, 3, 'opButton'),
            ('4', 2, 0, ''), ('5', 2, 1, ''), ('6', 2, 2, ''), ('-', 2, 3, 'opButton'),
            ('1', 3, 0, ''), ('2', 3, 1, ''), ('3', 3, 2, ''), ('+', 3, 3, 'opButton'),
            ('0', 4, 0, ''), ('.', 4, 1, ''), ('⌫', 4, 2, 'opButton'), ('=', 4, 3, 'equalsButton')
        ]

        for text, row, col, btn_type in buttons:
            btn = QPushButton(text)
            if btn_type:
                btn.setObjectName(btn_type)
            btn.clicked.connect(self.on_button_clicked)
            grid_layout.addWidget(btn, row, col)

        layout.addLayout(grid_layout)
        
        # المتغيرات الخاصة بالعمليات الحسابية
        self.current_text = ""

    def on_button_clicked(self):
        sender = self.sender().text()
        
        current_display = self.display.text()
        if current_display == "0" or current_display == "Error":
            current_display = ""

        if sender == 'C':
            self.display.setText("0")
        elif sender == '⌫':
            if len(current_display) > 1:
                self.display.setText(current_display[:-1])
            else:
                self.display.setText("0")
        elif sender == '=':
            try:
                # استبدال الرموز لتعمل بشكل صحيح في بايثون
                expression = current_display.replace('×', '*').replace('÷', '/')
                result = str(eval(expression))
                self.display.setText(result)
            except Exception:
                self.display.setText("Error")
        else:
            if current_display == "0" and sender in "1234567890(":
                self.display.setText(sender)
            else:
                # استبدال الرموز المرئية برمز البرمجة المناسب
                if sender == '*': sender = '×'
                if sender == '/': sender = '÷'
                self.display.setText(current_display + sender)

if __name__ == '__main__':
    app = QApplication(sys.argv)
    calc = AICalculatorPro()
    calc.show()
    sys.exit(app.exec_())